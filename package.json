{
  "name": "@blzsky/variant",
  "version": "0.2.1",
  "description": "Change intelligence for TypeScript monorepos — AST-level blast radius, test impact, and a cached task DAG",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    }
  },
  "bin": {
    "variant": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run --coverage",
    "bench": "node benchmarks/bench.mjs",
    "bench:quick": "node benchmarks/bench.mjs --quick",
    "accuracy": "node accuracy/replay.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "prepublishOnly": "pnpm test:all && pnpm build",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "monorepo",
    "test-impact",
    "change-detection",
    "typescript",
    "build",
    "orchestration",
    "task-runner",
    "caching",
    "dag"
  ],
  "author": "Bluesky Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saintparish4/variant.git"
  },
  "homepage": "https://github.com/saintparish4/variant#readme",
  "bugs": {
    "url": "https://github.com/saintparish4/variant/issues"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "string-argv": "^0.3.2",
    "ts-morph": "^28.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@rolldown/binding-win32-x64-msvc": "^1.1.3",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": ">=8.0.5 <9",
    "vitest": "^4.1.11"
  }
}
